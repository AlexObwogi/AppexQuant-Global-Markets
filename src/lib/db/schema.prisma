// AppexQuant Markets Global - Production Prisma Schema
// Optimized for High-Concurrency Connection Pooling (PgBouncer / Prisma Accelerate)
// Includes strict indexes for sub-millisecond query execution on high-frequency tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  SUPPORT_AGENT
  CONTENT_MANAGER
  TRADING_OPERATOR
  RISK_MANAGER
  AI_OPERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AccountEnvironment {
  DEMO
  PAPER
  LIVE
}

model User {
  id              String         @id @default(uuid()) @db.VarChar(64)
  email           String         @unique @db.VarChar(255)
  username        String?        @unique @db.VarChar(100)
  displayName     String?        @map("display_name") @db.VarChar(150)
  avatar          String?        @db.VarChar(512)
  role            Role           @default(USER)
  status          UserStatus     @default(ACTIVE)
  derivAccountId  String?        @map("deriv_account_id") @db.VarChar(64)
  accountType     String?        @default("demo") @map("account_type") @db.VarChar(20)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?      @map("last_login_at") @db.Timestamptz(6)

  // Relations
  profile         UserProfile?
  preferences     UserPreferences?
  sessions        Session[]
  derivAccounts   DerivAccount[]
  orders          Order[]
  positions       Position[]
  posts           CommunityPost[]
  legalRecords    LegalAcceptance[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([role, status])
  @@index([derivAccountId])
  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  userId               String   @id @map("user_id") @db.VarChar(64)
  bio                  String?  @db.Text
  experienceLevel      String?  @default("BEGINNER") @map("experience_level") @db.VarChar(30)
  preferredEnvironment String?  @default("DEMO") @map("preferred_environment") @db.VarChar(20)
  country              String?  @db.VarChar(3)
  phone                String?  @db.VarChar(30)
  kycStatus            String?  @default("UNVERIFIED") @map("kyc_status") @db.VarChar(30)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([country])
  @@index([kycStatus])
  @@map("user_profiles")
}

model UserPreferences {
  userId                String   @id @map("user_id") @db.VarChar(64)
  theme                 String   @default("dark") @db.VarChar(20)
  notificationsEnabled  Boolean  @default(true) @map("notifications_enabled")
  timezone              String   @default("UTC") @db.VarChar(50)
  language              String   @default("en") @db.VarChar(10)
  defaultMarket         String   @default("EURUSD") @map("default_market") @db.VarChar(50)
  defaultTimeframe      String   @default("15m") @map("default_timeframe") @db.VarChar(10)
  balanceVisibleDefault Boolean  @default(false) @map("balance_visible_default")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Session {
  id          String    @id @default(uuid()) @db.VarChar(64)
  userId      String    @map("user_id") @db.VarChar(64)
  token       String    @unique @db.VarChar(512)
  csrfToken   String    @map("csrf_token") @db.VarChar(128)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  isElevated  Boolean   @default(false) @map("is_elevated")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActive  DateTime  @default(now()) @map("last_active") @db.Timestamptz(6)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([token])
  @@map("auth_sessions")
}

model DerivAccount {
  id            String                 @id @db.VarChar(64) // External Deriv loginid e.g. CR123456 / VRTC123456
  userId        String                 @map("user_id") @db.VarChar(64)
  accountType   String                 @default("demo") @map("account_type") @db.VarChar(20)
  currency      String                 @default("USD") @db.VarChar(10)
  balance       Decimal                @default(0) @db.Decimal(18, 4)
  equity        Decimal?               @default(0) @db.Decimal(18, 4)
  isVirtual     Boolean                @default(false) @map("is_virtual")
  isDisabled    Boolean                @default(false) @map("is_disabled")
  status        String                 @default("ACTIVE") @db.VarChar(20)
  lastSyncedAt  DateTime?              @map("last_synced_at") @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots     DerivAccountSnapshot[]

  @@index([userId, accountType])
  @@index([userId, updatedAt])
  @@map("deriv_accounts")
}

model DerivAccountSnapshot {
  id             String       @id @default(uuid()) @db.VarChar(64)
  derivAccountId String       @map("deriv_account_id") @db.VarChar(64)
  userId         String       @map("user_id") @db.VarChar(64)
  balance        Decimal      @db.Decimal(18, 4)
  equity         Decimal?     @db.Decimal(18, 4)
  currency       String       @default("USD") @db.VarChar(10)
  snapshotKey    String       @map("snapshot_key") @db.VarChar(64) // Idempotent key: e.g. `${derivAccountId}_${timestampHour}`
  timestamp      DateTime     @default(now()) @db.Timestamptz(6)

  account        DerivAccount @relation(fields: [derivAccountId], references: [id], onDelete: Cascade)

  @@unique([derivAccountId, snapshotKey])
  @@index([derivAccountId, timestamp])
  @@index([userId, timestamp])
  @@map("deriv_account_snapshots")
}

model Order {
  id             String             @id @default(uuid()) @db.VarChar(64)
  userId         String             @map("user_id") @db.VarChar(64)
  environment    AccountEnvironment @default(DEMO)
  symbol         String             @db.VarChar(50)
  orderType      String             @map("order_type") @db.VarChar(30)
  side           String             @db.VarChar(10)
  volume         Decimal            @db.Decimal(12, 4)
  requestedPrice Decimal?           @map("requested_price") @db.Decimal(18, 6)
  executionPrice Decimal?           @map("execution_price") @db.Decimal(18, 6)
  status         String             @default("PENDING") @db.VarChar(30)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  executedAt     DateTime?          @map("executed_at") @db.Timestamptz(6)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([symbol, status])
  @@index([environment, status])
  @@map("orders")
}

model Position {
  id             String             @id @default(uuid()) @db.VarChar(64)
  userId         String             @map("user_id") @db.VarChar(64)
  environment    AccountEnvironment @default(DEMO)
  symbol         String             @db.VarChar(50)
  side           String             @db.VarChar(10)
  volume         Decimal            @db.Decimal(12, 4)
  entryPrice     Decimal            @map("entry_price") @db.Decimal(18, 6)
  currentPrice   Decimal            @map("current_price") @db.Decimal(18, 6)
  unrealizedPnl  Decimal            @default(0) @map("unrealized_pnl") @db.Decimal(18, 4)
  status         String             @default("OPEN") @db.VarChar(20)
  openedAt       DateTime           @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt       DateTime?          @map("closed_at") @db.Timestamptz(6)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([symbol, status])
  @@map("positions")
}

model LeaderboardEntry {
  id                     String   @id @default(uuid()) @db.VarChar(64)
  userId                 String   @map("user_id") @db.VarChar(64)
  username               String   @db.VarChar(100)
  displayName            String   @map("display_name") @db.VarChar(150)
  avatar                 String   @db.VarChar(10)
  country                String   @db.VarChar(100)
  window                 String   @db.VarChar(20) // WEEKLY, MONTHLY, YEARLY, ALL_TIME
  rank                   Int
  winRate                Decimal  @map("win_rate") @db.Decimal(5, 2)
  profitFactor           Decimal  @map("profit_factor") @db.Decimal(6, 2)
  totalProfitUsd         Decimal  @map("total_profit_usd") @db.Decimal(18, 2)
  roiPercentage          Decimal  @map("roi_percentage") @db.Decimal(8, 2)
  maxDrawdownPercentage  Decimal  @map("max_drawdown_percentage") @db.Decimal(5, 2)
  totalTrades            Int      @map("total_trades")
  firstPlaceFinishes     Int      @default(0) @map("first_place_finishes")
  isAllTimeLeader        Boolean  @default(false) @map("is_all_time_leader")
  isVerified             Boolean  @default(true) @map("is_verified")
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, window])
  @@index([window, rank])
  @@index([window, totalProfitUsd])
  @@index([isAllTimeLeader])
  @@map("leaderboard_entries")
}

model CommunityPost {
  id             String        @id @default(uuid()) @db.VarChar(64)
  authorId       String        @map("author_id") @db.VarChar(64)
  title          String        @db.VarChar(200)
  content        String        @db.Text
  category       String        @default("GENERAL") @db.VarChar(50)
  likesCount     Int           @default(0) @map("likes_count")
  commentsCount  Int           @default(0) @map("comments_count")
  isPinned       Boolean       @default(false) @map("is_pinned")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments       PostComment[]

  @@index([category, createdAt])
  @@index([authorId, createdAt])
  @@index([likesCount])
  @@map("community_posts")
}

model PostComment {
  id         String        @id @default(uuid()) @db.VarChar(64)
  postId     String        @map("post_id") @db.VarChar(64)
  authorId   String        @map("author_id") @db.VarChar(64)
  content    String        @db.Text
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("post_comments")
}

model LegalAcceptance {
  id           String   @id @default(uuid()) @db.VarChar(64)
  userId       String   @map("user_id") @db.VarChar(64)
  documentId   String   @map("document_id") @db.VarChar(100)
  version      String   @db.VarChar(20)
  acceptedAt   DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(512)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId, version])
  @@index([userId])
  @@map("legal_acceptances")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     String   @map("actor_id") @db.VarChar(64)
  actionType  String   @map("action_type") @db.VarChar(100)
  target      String?  @db.VarChar(150)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([actionType, createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id          Int      @id @default(autoincrement())
  userId      String?  @map("user_id") @db.VarChar(64)
  eventType   String   @map("event_type") @db.VarChar(100)
  severity    String   @default("WARNING") @db.VarChar(20)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, eventType])
  @@index([severity, createdAt])
  @@map("security_events")
}
