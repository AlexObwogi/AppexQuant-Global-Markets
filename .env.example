# GEMINI_API_KEY: Required for server-side Gemini AI features.
GEMINI_API_KEY=""

# APP_URL: Base URL of the deployed application
APP_URL="http://localhost:3000"

# RUNTIME CONFIGURATION
NODE_ENV="production"
PORT=3000

# DERIV OAUTH 2.0 PKCE CONFIGURATION (SERVER-SIDE ONLY)
DERIV_OAUTH_CLIENT_ID=""
DERIV_OAUTH_CLIENT_SECRET=""
DERIV_OAUTH_REDIRECT_URI=""
DERIV_OAUTH_SCOPES="read,trade"

# DERIV PARTNER ATTRIBUTION & CAMPAIGNS
DERIV_AFFILIATE_TOKEN=""
DERIV_UTM_SOURCE="appexquant"
DERIV_UTM_CAMPAIGN="trader_partner"
DERIV_UTM_MEDIUM="web_app"

# SUPABASE PRODUCTION PERSISTENCE (OPTIONAL / ENTERPRISE)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# DIRECT POSTGRESQL CONNECTION (OPTIONAL)
DATABASE_URL=""

# CRYPTOGRAPHIC KEYS & SECRETS
JWT_SECRET=""
ENCRYPTION_KEY=""
SESSION_SECRET=""
