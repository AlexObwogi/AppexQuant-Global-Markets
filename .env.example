# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# APPEXQUANT CONFIGURATION
NODE_ENV="development"
APP_ENV="development"
APP_VERSION="0.1.0"
PORT=3000
ENABLE_FEATURE_FLAGS="true"
ENABLE_PWA="true"

# DERIV OAUTH 2.0 PKCE & PARTNER ATTRIBUTION CONFIGURATION
DERIV_CLIENT_ID="1001"
DERIV_APP_ID="1001"
DERIV_OAUTH_REDIRECT_URI="https://appexquant.global/api/auth/deriv/callback"
DERIV_AFFILIATE_TOKEN="AFF_APPEXQUANT_GLOBAL"
DERIV_UTM_SOURCE="appexquant"
DERIV_UTM_CAMPAIGN="trader_partner"
DERIV_UTM_MEDIUM="app_integration"

