{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/server.cjs",
      "maxDuration": 30,
      "memory": 1024
    },
    "api/deriv/stream.ts": {
      "includeFiles": "dist/server.cjs",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/deriv/stream", "destination": "/api/deriv/stream.ts" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/auth/(.*)", "destination": "/api/index.ts" },
    { "source": "/callback", "destination": "/api/index.ts" },
    { "source": "/((?!api/|auth/|callback).*)", "destination": "/index.html" }
  ]
}
