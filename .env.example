# AppExQuant Markets Global - Environment Configuration Template
# Copy this file to .env and configure local secrets. Never commit actual secrets.

# Node Environment
NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgres://appexquant:appexquant_secure_pass@localhost:5432/appexquant_markets

# Deriv OAuth Configuration
DERIV_APP_ID=1089
DERIV_OAUTH_CLIENT_ID=1089
DERIV_OAUTH_SECRET=your_deriv_oauth_secret_here
DERIV_REDIRECT_URI=http://localhost:3000/api/auth/deriv/callback

# Session & Security Secrets
SESSION_SECRET=your_secure_session_hmac_secret_here
JWT_SECRET=your_secure_jwt_secret_here

# AI Quant Intelligence (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
